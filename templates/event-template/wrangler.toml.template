# Cloudflare Pages Configuration for Event: {{EVENT_TITLE}}
# Dedicated Account Email: {{ADMIN_EMAIL}}

name = "{{EVENT_ID}}"
compatibility_date = "2024-09-01"
pages_build_output_dir = "public"

# Isolated D1 Database for this Event
[[d1_databases]]
binding = "DB"
database_name = "{{D1_DATABASE_NAME}}"
database_id = "{{D1_DATABASE_ID}}"

[vars]
# Secrets are NOT stored here. Set them per Pages project (Settings > Variables and Secrets, type Secret)
# or with: npx wrangler pages secret put ADMIN_KEY --project-name <project>
#   ADMIN_KEY            curator admin key
#   SHARED_SECRET_TOKEN  Bearer token sent to Master /api/sync (must match registered_events.secret_token)
EVENT_ID = "{{EVENT_ID}}"
EVENT_TITLE = "{{EVENT_TITLE}}"
ADMIN_EMAIL = "{{ADMIN_EMAIL}}"
MASTER_PORTAL_URL = "{{MASTER_PORTAL_URL}}"
EVENT_PAGE_BASE_URL = "{{EVENT_PAGE_BASE_URL}}"
EVENT_THEME = "heritage"

# Dedicated Cloudinary Storage Account for this Event
CLOUDINARY_CLOUD_NAME = "{{CLOUDINARY_CLOUD_NAME}}"
CLOUDINARY_UPLOAD_PRESET = "{{CLOUDINARY_UPLOAD_PRESET}}"
