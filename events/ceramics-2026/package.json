{
  "name": "ceramics-2026",
  "version": "1.0.0",
  "description": "Virtual Exhibition Instance for Contemporary Ceramic Art Biennial 2026",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=d1-ceramics-2026 --local",
    "init-db:local": "wrangler d1 execute d1-ceramics-2026 --file=schema.sql --local",
    "init-db:remote": "wrangler d1 execute d1-ceramics-2026 --file=schema.sql --remote",
    "deploy": "wrangler pages deploy public"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
